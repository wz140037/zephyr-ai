{
  "name": "zephyr-ai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:demos": "pnpm --filter demos dev",
    "build:demos": "pnpm --filter demos build",
    "docs:dev": "pnpm --filter docs docs:dev",
    "docs:build": "pnpm --filter docs docs:build",
    "docs:deploy": "gh-pages -d docs/.vitepress/dist -b pages -f"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}